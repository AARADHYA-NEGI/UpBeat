{
  "appId": "com.aaradhya.upbeat",
  "appName": "UpBeat",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "path": "../android",
    "allowMixedContent": true,
    "backgroundColor": "#000000"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": "off"
    }
  }
}
